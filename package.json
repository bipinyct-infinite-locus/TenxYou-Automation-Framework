{
  "name": "tenxyou-automation-framework",
  "version": "2.0.0",
  "description": "Production-grade Playwright TypeScript automation framework for TenxYou",
  "scripts": {
    "test": "playwright test",
    "test:staging": "ENVIRONMENT=staging playwright test",
    "test:prod": "ENVIRONMENT=production playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:home": "playwright test tests/home",
    "test:plp": "playwright test tests/plp",
    "test:pdp": "playwright test tests/pdp",
    "test:cart": "playwright test tests/cart",
    "test:checkout": "playwright test tests/checkout",
    "test:search": "playwright test tests/search",
    "test:wishlist": "playwright test tests/wishlist",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:sanity": "playwright test --grep @sanity",
    "report": "playwright show-report reports/html",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open",
    "auth:setup": "playwright test auth.setup.ts",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.5",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "allure-playwright": "^3.0.0",
    "allure-commandline": "^2.27.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "@faker-js/faker": "^8.4.1",
    "pg": "^8.11.5",
    "ajv": "^8.13.0",
    "winston": "^3.13.0",
    "dayjs": "^1.11.10"
  }
}
